generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PropertyStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
  SOLD
  UNKNOWN
}

enum PropertyTypeGroup {
  WOHNHAEUSER
  WOHNUNGEN
  GEWERBE
  GRUNDSTUECKE
  LAND_WALD
  GARAGEN
  SONSTIGE
}

enum OccupancyStatus {
  VACANT
  RENTED
  OWNER_OCCUPIED
  UNKNOWN
}

enum DocumentType {
  GUTACHTEN
  BEKANNTMACHUNG
  EXPOSE
  FOTO
  OTHER
}

enum UserRole {
  USER
  ADMIN
}

model Property {
  id                       String            @id @default(cuid())
  aktenzeichen             String
  normalizedAktenzeichen   String
  court                    String
  state                    String
  city                     String
  postalCode               String
  street                   String
  houseNumber              String?
  address                  String
  latitude                 Float?
  longitude                Float?

  title                    String
  propertyType             String
  propertyTypeGroup        PropertyTypeGroup
  status                   PropertyStatus    @default(ACTIVE)
  occupancyStatus          OccupancyStatus   @default(UNKNOWN)

  auctionDate              DateTime?
  auctionTime              String?
  auctionLocation          String?
  marketValue              Int?
  livingArea               Float?
  usableArea               Float?
  totalArea                Float?
  plotArea                 Float?
  yearBuilt                Int?
  hasDenkmalschutz         Boolean           @default(false)
  wertgrenzenWeggefallen   Boolean           @default(false)
  auctionAttempt           Int               @default(1)

  description              String            @db.Text
  locationDescription      String?           @db.Text
  cancellationText         String?           @db.Text
  source                   String            @default("TEST_SEED")
  sourceUrl                String?
  lastSourceUpdate         DateTime?

  images                   PropertyImage[]
  documents                PropertyDocument[]
  favorites                Favorite[]

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([state])
  @@index([court])
  @@index([city])
  @@index([postalCode])
  @@index([propertyTypeGroup])
  @@index([status])
  @@index([auctionDate])
  @@index([marketValue])
}

model PropertyImage {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url         String    @db.VarChar(1000)
  alt         String?
  isMain      Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId])
}

model PropertyDocument {
  id            String        @id @default(cuid())
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url           String        @db.VarChar(1000)
  filename      String
  documentType  DocumentType  @default(OTHER)
  sourceUrl     String?       @db.VarChar(1000)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propertyId])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  passwordHash  String
  role          UserRole      @default(USER)
  favorites     Favorite[]
  savedSearches SavedSearch[]
  sessions      Session[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique @db.VarChar(191)
  userId        String
  expires       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  propertyId  String
  note        String?   @db.Text
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model SavedSearch {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String?
  filtersUrl            String    @db.VarChar(2000)
  filtersHash           String
  humanReadableSummary  String    @db.VarChar(1000)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, filtersHash])
  @@index([userId])
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model ImportLog {
  id            String        @id @default(cuid())
  source        String        @default("ADMIN_IMPORT")
  mode          String        @default("JSON")
  status        ImportStatus  @default(SUCCESS)
  totalItems    Int           @default(0)
  createdItems  Int           @default(0)
  updatedItems  Int           @default(0)
  skippedItems  Int           @default(0)
  failedItems   Int           @default(0)
  errorMessage  String?       @db.Text
  logJson       Json?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}
