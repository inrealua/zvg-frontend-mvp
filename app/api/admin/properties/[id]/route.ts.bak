import { NextRequest, NextResponse } from "next/server";
import { PrismaClient, Prisma } from "@prisma/client";
import fs from "node:fs";
import path from "node:path";

const prisma = new PrismaClient();

export const dynamic = "force-dynamic";
export const runtime = "nodejs";

function model(name: string) {
  return Prisma.dmmf.datamodel.models.find((m) => m.name === name);
}
function delegate(name: string) {
  return name.charAt(0).toLowerCase() + name.slice(1);
}
function hasField(modelName: string, field: string) {
  return Boolean(model(modelName)?.fields?.some((f) => f.name === field));
}
async function safeDeleteMany(tx: any, modelName: string, propertyId: string) {
  const d = delegate(modelName);
  if (!model(modelName) || !tx[d] || !hasField(modelName, "propertyId")) return;
  try {
    await tx[d].deleteMany({ where: { propertyId } });
  } catch {}
}
function removeAssetFolder(property: any) {
  const keys = [property?.externalId, property?.sourceExternalId, property?.sourceId].filter(Boolean);
  for (const key of keys) {
    const dir = path.join(process.cwd(), "public", "imports", "zvg-normalized", String(key));
    if (fs.existsSync(dir)) fs.rmSync(dir, { recursive: true, force: true });
  }
}

export async function DELETE(_request: NextRequest, ctx: { params: Promise<{ id: string }> }) {
  const { id } = await ctx.params;

  const property = await prisma.property.findUnique({ where: { id } });

  if (!property) {
    return NextResponse.json({ ok: false, error: "Not found" }, { status: 404 });
  }

  await prisma.$transaction(async (tx: any) => {
    for (const m of [
      "Favorite",
      "PropertyImage",
      "Image",
      "PropertyPhoto",
      "Photo",
      "PropertyDocument",
      "Document",
      "PropertyFile",
      "File",
      "PropertyTranslation",
      "PropertyStatusHistory",
      "PropertyStatusLog",
      "StatusHistory",
      "PropertyChangeLog",
      "PropertyHistory",
    ]) {
      await safeDeleteMany(tx, m, id);
    }
    await tx.property.delete({ where: { id } });
  });

  removeAssetFolder(property);

  return NextResponse.json({ ok: true });
}
