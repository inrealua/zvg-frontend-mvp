{
  "name": "zvg-frontend-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "import:zvgscout": "node scripts/import_zvgscout.cjs",
    "import:zvgscout:dry": "ZVGSCOUT_DRY_RUN=1 node scripts/import_zvgscout.cjs",
    "import:zvgscout:discover": "cross-env ZVGSCOUT_DISCOVERY_ONLY=1 ZVGSCOUT_MAX_PAGES=1 node scripts/import_zvgscout.cjs",
    "zvgscout:collect": "node scripts/zvgscout_collect_local.cjs",
    "zvgscout:import": "node scripts/zvgscout_import_local.cjs",
    "zvgscout:import:dry": "cross-env ZVGSCOUT_DRY_RUN=1 node scripts/zvgscout_import_local.cjs",
    "zvgscout:har": "python scripts/zvgscout_har_to_dataset.py",
    "zvgscout:import-dataset": "node scripts/zvgscout_import_dataset.cjs",
    "zvgscout:import-dataset:dry": "cross-env ZVGSCOUT_DRY_RUN=1 node scripts/zvgscout_import_dataset.cjs",
    "zvg:import-normalized-db": "node scripts/import_normalized_zvg_to_db.cjs",
    "zvg:import-normalized-db:dry": "cross-env ZVG_DRY_RUN=1 node scripts/import_normalized_zvg_to_db.cjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@prisma/client": "6.14.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "playwright": "^1.49.0",
    "prisma": "6.14.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
